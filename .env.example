# Copia este fichero a .env  (en PowerShell:  copy .env.example .env)
# Docker Compose solo lee un fichero llamado exactamente .env
# Todo es OPCIONAL: sin .env la plataforma arranca igual.

# Motor del chatbot:
#   ollama    -> modelo local afinado (llm/). Por defecto.
#   reglas    -> solo NLU por reglas (lo mas ligero).
#   anthropic -> agente con la API de Anthropic (necesita LLM_API_KEY).
LLM_PROVEEDOR=ollama

# Ollama. Por defecto el contenedor 'ollama' del compose. Para usar un
# Ollama instalado en tu equipo (en Mac usa la GPU):
#   OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=
OLLAMA_MODELO=pids-nlu
OLLAMA_MODELO_RESPALDO=qwen2.5:1.5b
# Cuantizar al instalar el modelo afinado (solo si se exporto en f16)
CUANTIZAR=

# Solo para LLM_PROVEEDOR=anthropic
LLM_API_KEY=
LLM_MODELO=claude-sonnet-5

# Secreto para firmar los tokens de sesion (minimo 32 caracteres).
# Si lo dejas vacio se genera uno aleatorio en cada arranque de la API:
# funciona igual, pero las sesiones abiertas se cierran al reiniciarla.
JWT_SECRETO=

# Ventana del limitador de consumo por empresa, en segundos.
VENTANA_CUOTA_SEG=60
