# Copia este fichero a .env  (en PowerShell:  copy .env.example .env)
# Docker Compose solo lee un fichero llamado exactamente .env

# =====================================================================
# Motor del chatbot
# =====================================================================
# El proyecto NO esta atado a ningun proveedor. Elige uno de los cuatro.
# Si no tocas nada, arranca en modo reglas: sin claves y sin coste.

LLM_PROVEEDOR=auto

# --- Opcion 1: reglas (por defecto) ----------------------------------
# NLU propio por palabras clave. Cero dependencias externas, cero coste,
# funciona sin internet. Todos los casos de uso, E6 y E7 se pueden
# probar en este modo.
#
#   LLM_PROVEEDOR=reglas

# --- Opcion 2: Ollama, modelo abierto en local (recomendado) ---------
# Sin clave y sin coste, y los datos NO salen de la plataforma.
# Arranca con:   docker compose --profile ollama up
# La primera vez descarga el modelo (unos 2 GB); despues ya lo tiene.
#
#   LLM_PROVEEDOR=ollama
#   OLLAMA_MODELO=qwen2.5:3b
#
# Modelos con soporte de herramientas, de menor a mayor exigencia:
#   qwen2.5:3b      ~2 GB   va en cualquier portatil
#   llama3.1:8b     ~5 GB   mejor calidad, mas lento sin GPU

# --- Opcion 3: API compatible con OpenAI -----------------------------
# Groq tiene nivel gratuito y es muy rapido. Tambien vale Gemini u OpenAI.
#
#   LLM_PROVEEDOR=openai
#   LLM_API_KEY=tu-clave
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODELO=llama-3.3-70b-versatile

# --- Opcion 4: API de Anthropic --------------------------------------
# Requiere cuenta de pago por uso (distinta de la suscripcion de la app).
#
#   LLM_PROVEEDOR=anthropic
#   LLM_API_KEY=tu-clave
#   LLM_MODELO=claude-sonnet-5

LLM_API_KEY=
LLM_MODELO=
LLM_BASE_URL=
OLLAMA_MODELO=qwen2.5:3b


# =====================================================================
# Seguridad
# =====================================================================
# Secreto para firmar los tokens de sesion. Cambialo por cualquier
# cadena larga y aleatoria.
JWT_SECRETO=cambia-esto-por-una-cadena-larga-y-aleatoria


# =====================================================================
# Limites
# =====================================================================
# Ventana del limitador de consumo por empresa, en segundos (E7).
VENTANA_CUOTA_SEG=60
